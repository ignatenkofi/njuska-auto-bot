# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

# Note on Cloudflare: polovniautomobili.com is fronted by Cloudflare Managed
# Challenge that fingerprints reqwest+hyper at the TLS/protocol layer and 403s
# every variant we tried (HTTP/2 and HTTP/1.1, rustls and native-tls, minimal
# and rich header sets). We sidestep it by shelling out to system `curl`, which
# passes cleanly on macOS — but Linux curl also gets 403 (the differentiator
# is somewhere in the TCP/TLS stack below curl's control).
#
# If deploying on Linux (VM, VPS), set up the CF Worker proxy from `cf-proxy/`
# (see cf-proxy/README.md for the 5-minute setup) and fill in CF_PROXY_URL +
# CF_PROXY_SECRET below. On macOS direct fetch works without the proxy.

# Optional: Cloudflare Worker proxy. When BOTH set, the bot routes fetches
# through the Worker. Either left blank → direct fetch.
CF_PROXY_URL=
CF_PROXY_SECRET=

# --- Telegram ---
# Bot token from @BotFather, e.g. 123456789:ABCDEF...
TELEGRAM_BOT_TOKEN=

# Where to send notifications. Same `chat_id` field handles all three:
#
#   personal chat   -> positive integer, e.g. 165838517
#                      Get it from @userinfobot. You must press /start in the
#                      bot first or sendMessage will 403.
#
#   channel         -> negative integer starting with -100, e.g. -1001234567890
#                      Create the channel, add the bot as an admin (with
#                      "Post Messages" permission). To get the ID: add
#                      @userinfobot as admin too, it'll print the channel ID.
#                      Best option if you want family/friends to subscribe.
#
#   group           -> negative integer (without the -100 prefix in some cases).
#                      Add bot to the group.
TELEGRAM_CHAT_ID=

# --- v2: interactive commands ---
# Telegram user ID of the *only* person allowed to send commands to the bot
# (/status, /pause, /interval, /filter ...). Anyone else's commands are
# silently ignored — logged at warn level so you can see if someone is
# probing the bot.
#
# Same way to find it as TELEGRAM_CHAT_ID: message @userinfobot and copy your
# numeric ID. If you're sending notifications to your *own* personal chat
# (not a channel), this is the same number as TELEGRAM_CHAT_ID.
AUTHORIZED_USER_ID=

# --- Storage ---
# Path to the SQLite file. Relative to the working directory is fine.
DATABASE_PATH=./njuska.db

# --- Polling ---
# How often to poll the site, in seconds. 600 = 10 min. Don't go below 600 — be polite.
POLL_INTERVAL_SECS=600

# Number of consecutive zero-result polls before raising an alert
# (likely indicates the site's HTML structure changed and the parser is broken).
ZERO_RESULTS_ALERT_THRESHOLD=3

# Number of consecutive *fetch* failures (network error, Cloudflare 403,
# proxy misconfig) before raising a Telegram alert. While the streak grows,
# the bot also stretches its polling sleep (up to 4x the interval) to avoid
# hammering a site that's rejecting it.
FETCH_ERRORS_ALERT_THRESHOLD=3

# --- Debug ---
# When true, save raw HTML responses under DUMPS_DIR/YYYY-MM-DD/HHMMSS.html.
# Useful while the parser is young. Turn off once it's stable.
SAVE_RAW_HTML=true

# Where to put HTML dumps (one folder per day). Default: ./dumps
DUMPS_DIR=./dumps

# Delete day-folders older than this many days. 0 disables rotation (keep
# forever). Default: 7.
DUMP_RETENTION_DAYS=7

# Tracing filter. Examples:
#   info                                — everything at info+
#   njuska_auto_bot=debug,info           — debug for our crate, info for deps
RUST_LOG=njuska_auto_bot=debug,info

# --- Search filters (polovniautomobili.com query params) ---
# These map 1:1 to the site's URL query parameters. Leave empty to omit a filter.
#
# To discover the values for your search:
#  1. Open polovniautomobili.com, apply filters in the UI.
#  2. Copy the resulting URL — its query string contains the codes you need.
#  3. Map them to the keys below.

# Single-value: lower-case slug used in the site's URLs.
SEARCH_BRAND=

# Comma-separated list, mapped to the site's `model[]=...` array param.
#   Example: SEARCH_MODEL=cooper
#   Example: SEARCH_MODEL=cooper,clubman
SEARCH_MODEL=

# Comma-separated *numeric* body-type codes, mapped to `chassis[]=...`.
# A handful of common codes (full list visible in the site's filter UI):
#   2634 = Kabriolet/Roadster
#   2631 = Limuzina
#   2627 = Karavan
#   2629 = Hatchback
#   2628 = Coupe
#   2632 = SUV
SEARCH_CHASSIS=

# Numeric ranges. Leave empty to omit either bound.
SEARCH_PRICE_FROM=
SEARCH_PRICE_TO=
SEARCH_YEAR_FROM=
SEARCH_YEAR_TO=

# Show only old / only new / both. Default: all.
#   all | old | new
SEARCH_SHOW_OLD_NEW=all

# Include listings with no published price (the site allows hiding the price).
# Default: false.
SEARCH_WITHOUT_PRICE=false
